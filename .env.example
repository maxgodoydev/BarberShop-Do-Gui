# Copie para .env (NÃO versionado) ou defina no ambiente/plataforma de deploy. Valores abaixo são marcadores.
# Local. Para o Supabase veja docs/supabase.md (Session pooler + ?sslmode=require)
DB_URL=jdbc:postgresql://localhost:5432/barbershop_gui
DB_USERNAME=barbershop_app
DB_PASSWORD=<defina-uma-senha-forte>
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false            # local. Em produção use SPRING_PROFILES_ACTIVE=prod (força true)
FORWARD_HEADERS=none                   # local. Em produção, SPRING_PROFILES_ACTIVE=prod usa 'framework' (sem isso, atrás de proxy o limite de tentativas vira global)

# Conta inicial do proprietário (usada só se não houver nenhum usuário; remova depois do 1º acesso)
BOOTSTRAP_OWNER_USERNAME=<defina>
BOOTSTRAP_OWNER_PASSWORD=<12+ caracteres, exclusiva>

# E-mail: dev NÃO envia nada (link aparece só no log local). smtp envia de verdade.
MAIL_MODE=dev
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Dados públicos (deixe vazio até confirmar com o proprietário; nada é inventado)
SHOP_ADDRESS=Avenida Presidente João Goulart 940, São Paulo - SP
SHOP_PHONE=
SHOP_WHATSAPP_URL=
SHOP_MAPS_URL=https://maps.app.goo.gl/LhZ4Yg1AMcXsRRKK7
SHOP_HOURS_TEXT=Seg 11h-20h30 | Ter a Sáb 10h-20h30 | Dom fechado
SHOP_INSTAGRAM_URL=https://www.instagram.com/barbershop_dogui/

# Pipeline Python (usuário SOMENTE LEITURA nas views analíticas)
ANALYTICS_DB_URL=postgresql://analytics_ro:<senha>@localhost:5432/barbershop_gui
